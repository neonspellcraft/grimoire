<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows release zip (slug: windows-zip). Paste this into the
  grimoire project in the SignPath web app. It signs grimoire.exe inside the zip with Authenticode
  (SHA-256, timestamped) and leaves every other file untouched.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <directory path="Grimoire">
      <pe-file path="grimoire.exe" product-name="Grimoire" max-matches="1">
        <authenticode-sign hash-algorithm="sha256" />
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
